{
    "outputDirectory": "client/dist",
    "maxDuration": 60,
    "rewrites": [
        {
            "source": "/ping",
            "destination": "/api/index.js"
        },
        {
            "source": "/transcribe",
            "destination": "/api/index.js"
        },
        {
            "source": "/validate",
            "destination": "/api/index.js"
        },
        {
            "source": "/assess-soap",
            "destination": "/api/index.js"
        },
        {
            "source": "/generate-document",
            "destination": "/api/index.js"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/index.js": {
            "includeFiles": "{server/**,client/dist/**}",
            "maxDuration": 60
        }
    }
}